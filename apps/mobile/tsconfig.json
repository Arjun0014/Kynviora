{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@kynviora/domain": ["../../packages/domain/src/index.ts"],
      "@kynviora/contracts": ["../../packages/contracts/src/index.ts"],
      "@kynviora/presentation": ["../../packages/presentation/src/index.ts"],
      "@kynviora/catalog": ["../../packages/catalog/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}

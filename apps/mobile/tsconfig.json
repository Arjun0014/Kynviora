{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // A phone is not a browser and is not Node, and the compiler must not be told otherwise.
    // `expo/tsconfig.base` sets `lib: ["DOM", "ESNext"]`, and the monorepo's hoisted `@types/node`
    // is picked up ambiently - between them, `crypto.randomUUID()` typechecked in eight places and
    // threw `Property 'crypto' doesn't exist` on Hermes at the moment somebody pressed Save. This
    // is the only gate over `apps/**`: it is outside the test run and outside the lint run
    // (trap 164), so a global the runtime does not have has to fail here or nowhere (`DEV-043`).
    // Everything the app genuinely uses - fetch, console, timers, URL - is declared by React
    // Native's own types, which arrive through imports rather than through `@types`.
    "lib": ["ESNext"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@kynviora/domain": ["../../packages/domain/src/index.ts"],
      "@kynviora/contracts": ["../../packages/contracts/src/index.ts"],
      "@kynviora/presentation": ["../../packages/presentation/src/index.ts"],
      "@kynviora/catalog": ["../../packages/catalog/src/index.ts"]
    }
  },
  // `test/**` is included so the harness is typechecked too. It is not app code and Metro never
  // sees it, but it is the thing every component test depends on being right - an untyped tree
  // walker that silently returns nothing is a suite that passes over an empty screen.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}

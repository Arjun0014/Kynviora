{
  "expo": {
    "name": "Kynviora",
    "slug": "kynviora",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kynviora",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.kynviora.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.kynviora.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Kynviora uses the camera to read the number under a barcode. It does not take a photograph, and nothing from the camera is stored or sent anywhere.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "_comment": "Only non-secret values. Spec 14 forbids any secret in mobile configuration."
    }
  }
}

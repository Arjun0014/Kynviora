{
  "name": "kynviora",
  "private": true,
  "version": "0.1.0",
  "description": "Kynviora - family safety layer for medicines and personal-care products",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "db",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "verify": "npm run typecheck && npm run typecheck:mobile && npm run lint && npm run format:check && npm test",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "dev": "npm --prefix services/api run dev",
    "dev:console": "npm --prefix services/staff-web run dev",
    "migrate": "npm --prefix db run migrate",
    "verify:device": "tsx scripts/device/verifyLocalStorage.ts",
    "verify:device:a11y": "tsx scripts/device/verifyAccessibility.ts",
    "verify:device:reminders": "tsx scripts/device/verifyReminders.ts",
    "verify:device:update": "tsx scripts/device/verifyUpdate.ts",
    "verify:device:offline": "tsx scripts/device/verifyOfflineWrites.ts",
    "verify:device:profile": "tsx scripts/device/verifyProfileCreation.ts",
    "verify:device:caregiver": "tsx scripts/device/verifyCaregiverAccess.ts",
    "verify:device:visitpack": "tsx scripts/device/verifyVisitPackExport.ts",
    "verify:device:personalcare": "tsx scripts/device/verifyPersonalCare.ts",
    "verify:device:safety": "tsx scripts/device/verifySafetyScreen.ts",
    "verify:device:doseaccess": "tsx scripts/device/verifyDoseAccess.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.0"
  }
}

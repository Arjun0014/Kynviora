# Kynviora environment template. Copy to .env.local for development.
# SECURITY (spec 14): no secret in this file may ever be shipped in a mobile bundle.
# Mobile-safe values are prefixed EXPO_PUBLIC_ and must contain only non-secret identifiers.

NODE_ENV=development

# --- API service -------------------------------------------------------------
KYNVIORA_API_PORT=3000
KYNVIORA_API_BODY_LIMIT_BYTES=1048576

# --- Database (server-side only) ---------------------------------------------
# Never expose to the client. RLS is defense in depth, not the authorization boundary.
KYNVIORA_DATABASE_URL=

# --- Provider credentials (server-side only, spec 13/14) ---------------------
# Absent by default. Adapters fall back to deterministic local test adapters and the
# corresponding capability reports itself unavailable rather than silently degrading.
KYNVIORA_OCR_PROVIDER_KEY=
KYNVIORA_VISION_PROVIDER_KEY=
KYNVIORA_RESEARCH_PROVIDER_KEY=
KYNVIORA_CATALOG_PROVIDER_KEY=

# --- AI kill switches (spec 17) ----------------------------------------------
# Disabling any of these must not disable access to existing trusted records.
KYNVIORA_ENABLE_VISION_EXTRACTION=false
KYNVIORA_ENABLE_RESEARCH_DISCOVERY=false
KYNVIORA_ENABLE_REGULATORY_AI_EXTRACTION=false
KYNVIORA_ENABLE_AUTO_NORMALIZATION=false
KYNVIORA_ENABLE_AI_EXPLANATION_DRAFTING=false

# --- Development identity (server-side, spec 14) -----------------------------
# Phase 1.1 has not chosen an auth provider, so there is no real session yet. With this set to 1
# the API accepts an x-kynviora-dev-user header as identity. It REFUSES to start under
# NODE_ENV=production, and it grants no reviewer role (DEC-038, DEV-019).
KYNVIORA_DEV_AUTH=0
KYNVIORA_DEV_SEED=0
KYNVIORA_LOCAL_DB_DIR=.kynviora-data

# --- Mobile public config (safe to embed) ------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# The development identity the app acts as. Non-secret by construction: it is a user ID, not a
# credential, and it only means anything to a server running with KYNVIORA_DEV_AUTH=1 on
# loopback. The client refuses to send it to any other origin.
EXPO_PUBLIC_DEV_USER_ID=00000000-0000-4000-8000-00000000d001
# Assert step-up on every request. Off by default so the paths that require it (`14`: exports,
# caregiver administration, deletion) can be exercised in both directions.
EXPO_PUBLIC_DEV_STEP_UP=0

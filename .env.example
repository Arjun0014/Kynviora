# Kynviora environment template. Copy to .env.local for development.
# SECURITY (spec 14): no secret in this file may ever be shipped in a mobile bundle.
# Mobile-safe values are prefixed EXPO_PUBLIC_ and must contain only non-secret identifiers.

NODE_ENV=development

# --- API service -------------------------------------------------------------
KYNVIORA_API_PORT=3000
KYNVIORA_API_BODY_LIMIT_BYTES=1048576

# --- Database (server-side only) ---------------------------------------------
# Never expose to the client. RLS is defense in depth, not the authorization boundary.
#
# Absent means the local PGlite directory below. Set, it is a managed Postgres, and TWO
# credentials are used rather than one (see db/provision/README.md):
#
#   KYNVIORA_DATABASE_URL         the runtime role. NOINHERIT, no DDL privilege of any kind, and
#                                 a member of kynviora_app / _service / _retention so that every
#                                 statement must SET ROLE into one of them first.
#   KYNVIORA_MIGRATE_DATABASE_URL the DDL role, used by `npm run migrate` and nothing else. It
#                                 OWNS every table, which is what keeps a managed platform's
#                                 "whatever `postgres` creates, `anon` may read" default
#                                 privileges from ever applying to a health table.
#
# There is deliberately no fallback from one to the other: a fallback collapses them into a
# single credential holding both powers, which is the arrangement the split exists to avoid.
#
# The runtime URL must name a SESSION-scoped port. Identity here is a session GUC and privilege
# is a session role, and a transaction-mode pooler (Supavisor 6543) discards both between
# statements. The adapter refuses to serve a request whose role did not survive, so the failure
# is closed rather than silent - but the configuration is still wrong. Use 5432.
KYNVIORA_DATABASE_URL=
KYNVIORA_MIGRATE_DATABASE_URL=

# --- Provider credentials (server-side only, spec 13/14) ---------------------
# Absent by default. Adapters fall back to deterministic local test adapters and the
# corresponding capability reports itself unavailable rather than silently degrading.
KYNVIORA_OCR_PROVIDER_KEY=
KYNVIORA_VISION_PROVIDER_KEY=
KYNVIORA_RESEARCH_PROVIDER_KEY=
KYNVIORA_CATALOG_PROVIDER_KEY=

# --- AI kill switches (spec 17) ----------------------------------------------
# Disabling any of these must not disable access to existing trusted records.
KYNVIORA_ENABLE_VISION_EXTRACTION=false
KYNVIORA_ENABLE_RESEARCH_DISCOVERY=false
KYNVIORA_ENABLE_REGULATORY_AI_EXTRACTION=false
KYNVIORA_ENABLE_AUTO_NORMALIZATION=false
KYNVIORA_ENABLE_AI_EXPLANATION_DRAFTING=false

# --- Supabase Auth (server-side, spec 14, DEC-118/124/125) -------------------
# Setting the issuer turns on token verification and turns OFF the development header: a process
# that accepted both would be one where the weaker path decides, and it refuses to start.
#
# Neither of the first two is a secret. The issuer is a URL and the publishable key identifies the
# project and grants nothing; signatures are checked with a published public key, so this process
# holds nothing worth stealing.
KYNVIORA_SUPABASE_ISSUER=
KYNVIORA_SUPABASE_AUDIENCE=authenticated
# Needed by POST /v1/me, which reads the caller's own record from the provider to learn their
# address and whether it is verified - the access token carries no such claim.
KYNVIORA_SUPABASE_ANON_KEY=
#
# The service-role key IS a secret, and it is the only one here. It is used by exactly one thing:
# removing the identity behind an account in DELETE /v1/me. Absent, account deletion answers
# PROVIDER_UNAVAILABLE and changes nothing - it does not perform the half it can (DEC-125).
# Never in a mobile bundle, never in a log, never in this file.
KYNVIORA_SUPABASE_SERVICE_KEY=

# --- Development identity (server-side, spec 14) -----------------------------
# Phase 1.1 has not chosen an auth provider, so there is no real session yet. With this set to 1
# the API accepts an x-kynviora-dev-user header as identity. It REFUSES to start under
# NODE_ENV=production, and it grants no reviewer role (DEC-038, DEV-019).
KYNVIORA_DEV_AUTH=0
KYNVIORA_DEV_SEED=0
KYNVIORA_LOCAL_DB_DIR=.kynviora-data

# --- Retention (spec 16, DEC-121) --------------------------------------------
# What sweeps deleted personal data out of the database. `docs/RETENTION.md` promises it happens
# within 30 days, so a production process must say which of three things is true rather than being
# allowed to default into keeping a promise nothing keeps:
#   worker   - this process runs the sweep on a timer. The only arrangement that can touch the
#              local PGlite database, which is a single writer (DEC-037).
#   external - a separate deployment of services/worker does it.
#   none     - nothing does. Refused under NODE_ENV=production unless acknowledged below.
KYNVIORA_RETENTION=none
KYNVIORA_ALLOW_UNSWEPT_START=0

# How often. The interval is the maximum overshoot past every deadline in docs/RETENTION.md
# (`DEV-063`), not a performance setting: eligibility floors sit exactly on their deadlines, so a
# row is purged somewhere in [deadline, deadline + interval]. Capped at 24 hours, which is the
# shortest deadline in the matrix.
KYNVIORA_RETENTION_INTERVAL_MS=3600000
# How soon a sweep that did not fully succeed is tried again. Must not exceed the interval.
KYNVIORA_RETENTION_RETRY_MS=300000
# How long a worker's claim on the sweep survives the worker. Also the age at which an unfinished
# run is recorded as ABANDONED.
KYNVIORA_RETENTION_LEASE_MS=900000

# `npm run worker` refuses to open KYNVIORA_LOCAL_DB_DIR without this, because PGlite is a single
# writer and a second process on the same directory overwrites the first (DEC-037).
KYNVIORA_WORKER_ALLOW_LOCAL_DB=0

# --- Mobile public config (safe to embed) ------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# The development identity the app acts as. Non-secret by construction: it is a user ID, not a
# credential, and it only means anything to a server running with KYNVIORA_DEV_AUTH=1 on
# loopback. The client refuses to send it to any other origin.
EXPO_PUBLIC_DEV_USER_ID=00000000-0000-4000-8000-00000000d001
# Assert step-up on every request. Off by default so the paths that require it (`14`: exports,
# caregiver administration, deletion) can be exercised in both directions.
# `npm run verify:device:caregiver` needs this at 1, and a Metro restart with it: Expo inlines
# EXPO_PUBLIC_* into the bundle at build time, so changing it while Metro is running changes
# nothing on the device.
EXPO_PUBLIC_DEV_STEP_UP=0
